{
  "name": "opencode-translate-selection",
  "version": "0.2.0",
  "description": "Instant inline translation tooltip on text selection for OpenCode Desktop (v2.2.0+) with Smart Hybrid LLM/MT routing across all languages",
  "author": "Realmagnum",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Realmagnum/opencode-translate-selection.git"
  },
  "bugs": {
    "url": "https://github.com/Realmagnum/opencode-translate-selection/issues"
  },
  "homepage": "https://github.com/Realmagnum/opencode-translate-selection#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-desktop",
    "opencode-gui",
    "translation",
    "translator",
    "tooltip",
    "desktop",
    "solidjs",
    "electron",
    "llm",
    "ai"
  ],
  "type": "module",
  "files": [
    "dist",
    "src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.17",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.14"
  }
}
