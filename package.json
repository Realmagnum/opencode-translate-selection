{
  "name": "opencode-translate-selection",
  "version": "0.3.0",
  "description": "Instant inline translation tooltip for OpenCode Desktop (v2.2.0+) and Terminal TUI (hotkeys, last turn, side panel) with Smart Hybrid LLM/MT routing across all languages",
  "author": "Realmagnum",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Realmagnum/opencode-translate-selection.git"
  },
  "bugs": {
    "url": "https://github.com/Realmagnum/opencode-translate-selection/issues"
  },
  "homepage": "https://github.com/Realmagnum/opencode-translate-selection#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-desktop",
    "opencode-tui",
    "opencode-gui",
    "translation",
    "translator",
    "tooltip",
    "tui",
    "terminal",
    "desktop",
    "solidjs",
    "electron",
    "llm",
    "ai"
  ],
  "type": "module",
  "files": [
    "dist",
    "src",
    "server.ts",
    "tui.ts",
    "tui.tsx",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "build": "vite build && node build-tui.mjs",
    "build:gui": "vite build",
    "build:tui": "node build-tui.mjs",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@opentui/core": "^0.7.0",
    "@opentui/solid": "^0.7.0",
    "babel-preset-solid": "^1.9.16",
    "esbuild": "^0.28.2",
    "solid-js": "1.9.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.14"
  }
}
